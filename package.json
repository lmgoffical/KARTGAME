    "build": "vite build",
    "start": "node server/server.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  },
  "engines": { "node": ">=20" }
}
