{
  "name": "turbo-karts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "3D kart racing game with medals, checkpoints, a map builder, accounts and online versus.",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"vite\"",
